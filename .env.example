# Konfigurasi produksi (satu-satunya lingkungan, ADR-0008).
# Salin ke .env di root repo, lalu: chmod 600 .env. Jangan pernah commit .env.
# Format: KUNCI=nilai tanpa tanda kutip dan tanpa spasi di sekitar "=" (dibaca juga oleh Makefile & Docker Compose).

# --- aplikasi ---
PUBLIC_BASE_URL=https://scoreboard.tiusapp.com
LOG_LEVEL=info
# openssl rand -hex 32
SESSION_SECRET=

# --- cara kode diterapkan (ADR-0009) ---
# commit   = container hanya menjalankan kode yang sudah di-commit (HEAD) — disarankan
# worktree = container menjalankan isi folder apa adanya, termasuk yang belum di-commit
SOURCE_MODE=commit

# --- database (Postgres di deploy/compose.yml) ---
# PG_MAJOR harus sama dengan versi POSTGRES_IMAGE (dipakai pg_dump di image runtime)
POSTGRES_IMAGE=postgres:18
PG_MAJOR=18
# openssl rand -hex 24
POSTGRES_PASSWORD=

# --- login ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=scoreboard <no-reply@tiusapp.com>

# --- WhatsApp Cloud API ---
# Selama kosong, pesan hanya dicetak ke log (tidak terkirim) — aman sebelum nomor bisnis siap.
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_WEBHOOK_VERIFY_TOKEN=

# --- Xendit ---
# Sebelum peluncuran (T-135) pakai kunci TEST MODE dari dasbor Xendit; ganti ke kunci live saat rilis.
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_PLATFORM_FEE_IDR=2000

# --- object storage S3 (Contabo Object Storage atau lainnya) ---
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=scoreboard
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- gambar (openssl rand -hex 32 untuk keduanya) ---
IMGPROXY_KEY=
IMGPROXY_SALT=
